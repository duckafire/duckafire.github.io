{
  "name": "nest",
  "version": "4.0.0-alpha",
  "description": "DuckAfire's Nest: a projects showcase.",
  "main": "index.js",
  "scripts": {
    "b-all":    "npm run b-chunks && npm run b-index",
    "b-chunks": "node ./nodejs/create/projects.js",
    "b-index":  "node ./nodejs/insert-in-index-html.js",
    "b-css":    "npx sass ./scss/:./css/",

    "c-all":  "npm run c-html && npm run c-css",
    "c-css":  "test ! -d ./css/  && echo  '\"./css/\" not found' && exit 0; for file in $(ls ./css -I pure); do rm -r \"./css/$file\"; done",
    "c-html": "test ! -d ./html/ && echo '\"./html/\" not found' && exit 0; rm -r ./html/",

    "local": "npx http-server -c-1 -p 7777"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/duckafire/nest.git"
  },
  "keywords": [
    "duckafire",
    "nest",
    "showcase",
    "projects",
    "frontend"
  ],
  "author": "DuckAfire",
  "license": "GPL-3.0",
  "bugs": {
    "url": "https://github.com/duckafire/nest/issues"
  },
  "homepage": "https://github.com/duckafire/nest#readme",
  "devDependencies": {
    "http-server": "^14.1.1",
    "sass": "^1.32.11"
  }
}
